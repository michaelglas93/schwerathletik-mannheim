# Sanity — anlegen mit: npx sanity@latest login && npx sanity@latest init --project-plan free
# Ohne diese Werte läuft die Seite aus content/seed.json.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Nur für die einmalige Migration nötig (Sanity-Dashboard → API → Tokens, Rolle "Editor").
SANITY_API_WRITE_TOKEN=
